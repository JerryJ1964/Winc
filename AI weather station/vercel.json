{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/weather", "destination": "/api/weather" },
    { "source": "/weather/manual-update", "destination": "/api/weather" }
  ],
  "crons": [
    {
      "path": "/api/push?action=notify",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(sw.js|manifest.json|index.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
